# pkg-config for libtabnasebnf (tabnas-clib-template: v1)
# Install alongside the built library; substitute @PREFIX@ at install.
prefix=@PREFIX@
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libtabnasebnf
Description: ebnf parser (libtabnasebnf) — uniform tabnas C ABI (ADR-12)
Version: @VERSION@
Libs: -L${libdir} -ltabnasebnf
Cflags: -I${includedir}
